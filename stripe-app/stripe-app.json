{
  "$schema": "https://stripe.com/stripe-app.schema.json",
  "id": "com.snowseasonstech.saas-projection",
  "name": "SaaS Projection Engine",
  "version": "0.1.2",
  "icon": "icon.png",
  "ui_extension": {
    "views": [
      {
        "viewport": "stripe.dashboard.billing.overview",
        "component": "Projection"
      },
      {
        "viewport": "stripe.dashboard.subscription.list",
        "component": "SubscriptionsProjection"
      },
      {
        "viewport": "stripe.dashboard.home.overview",
        "component": "HomeProjection"
      },
      {
        "viewport": "stripe.dashboard.drawer.default",
        "component": "DefaultProjection"
      }
    ],
    "content_security_policy": {
      "purpose": ""
    }
  },
  "extensions": null,
  "permissions": [
    {
      "permission": "subscription_read",
      "purpose": "Reads active and recently canceled subscriptions to calculate your current MRR, new MRR and churn."
    },
    {
      "permission": "plan_read",
      "purpose": "Reads the prices on your subscriptions to convert each one to a monthly amount."
    }
  ],
  "distribution_type": "private",
  "stripe_api_access_type": "platform",
  "sandbox_install_compatible": true
}