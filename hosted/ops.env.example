# Copy to hosted/ops.env and fill in. Never commit ops.env.
# Subscribers get https://<id>.$HOSTED_DOMAIN and OAuth goes through https://oauth.$HOSTED_DOMAIN
HOSTED_DOMAIN=social.example.com
# Built with: docker build -t social-studio:0.5.0 products/social-studio
IMAGE=social-studio:0.5.0
# Read-only Stripe key with Subscriptions and Customers read access.
STRIPE_READ_KEY=
RESEND_API_KEY=
MAIL_FROM="Snow Seasons Tech <reports@snowseasonstech.net>"
OPS_EMAIL=info@snowseasonstech.net
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, shared by every subscriber
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
