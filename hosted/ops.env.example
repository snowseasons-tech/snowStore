# Copy to hosted/ops.env and fill in. Never commit ops.env.
# Subscribers get https://<id>.$HOSTED_DOMAIN and OAuth goes through https://oauth.$HOSTED_DOMAIN
HOSTED_DOMAIN=social.example.com
# Built with: docker build -t social-studio:0.5.0 products/social-studio
IMAGE=social-studio:0.5.0
# Read-only Stripe key with Subscriptions and Customers read access.
STRIPE_READ_KEY=
RESEND_API_KEY=
MAIL_FROM="Snow Seasons Tech <reports@snowseasonstech.net>"
OPS_EMAIL=info@snowseasonstech.net
# MailHub subscribers get https://<id>.$MAILHUB_DOMAIN
# Built with: docker build -t mailhub:0.1.0 products/mailhub
MAILHUB_DOMAIN=mail.example.com
MAILHUB_IMAGE=mailhub:0.1.0
MAILHUB_SEND_RATE=2
# Leave empty so each subscriber uses their own Resend account and pays for their own sending.
# A shared key puts every subscriber's reputation on one account, and everyone's webhooks share it too.
MAILHUB_RESEND_API_KEY=
MAILHUB_RESEND_WEBHOOK_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, shared by every subscriber
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
