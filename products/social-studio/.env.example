# Name shown in the browser tab and sidebar
APP_NAME=Social Studio
# 0 = only the first account can sign up; everyone else needs an invite code from a workspace owner.
# 1 = anyone who can reach the server can create an account.
ALLOW_REGISTRATION=0
# Connected accounts allowed across this server, for plans. 0 = no limit.
MAX_ACCOUNTS=0
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
DATABASE_URL=mysql+pymysql://studio:change-me@db:3306/studio?charset=utf8mb4
SECRET_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_KEY
FERNET_KEY=REPLACE_WITH_FERNET_KEY
PUBLIC_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_MODEL=
LLM_API_KEY=unused
# Email for "Forgot password?" links. Leave SMTP_HOST empty to turn email off
# (then reset passwords with: docker compose exec web python -m app.reset_password you@example.com).
# SMTP_SECURITY: starttls (usually port 587), ssl (usually port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=studio@example.com
