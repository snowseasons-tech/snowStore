# Copy to managed/ops.env (setup.sh does this) and fill in. Never commit ops.env.
# Reports and failure alerts are sent through Resend (same account the store uses).
RESEND_API_KEY=
MAIL_FROM="Snow Seasons Tech <reports@snowseasonstech.net>"
# Where failure alerts go, and a copy of every client report (leave empty to skip the copy).
OPS_EMAIL=info@snowseasonstech.net
